{
  "name": "demo",
  "version": "0.0.0",
  "private": "true",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev -r dotenv/config --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "node --check tests/server.test.js && node --check tests/integration.test.js && node --check tests/api-scenarios.js && node --check tests/money-migration.js && node --check tests/sql-query-plan.js && bash -n tests/race-condition.sh tests/idempotency.sh",
    "test": "npm run build && mocha tests/server.test.js",
    "test:integration": "npm run build && mocha --timeout 30000 tests/integration.test.js",
    "test:sql": "node tests/money-migration.js && node tests/sql-query-plan.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.0",
    "mocha": "^10.2.0",
    "prisma": "^7.8.0",
    "supertest": "^6.3.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "description": "This project is based on a GitLab [Project Template](https://docs.gitlab.com/ee/user/project/#create-a-project-from-a-built-in-template).",
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoopyTL/tixgo-backend.git"
  },
  "keywords": [],
  "author": "",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/hoopyTL/tixgo-backend/issues"
  },
  "homepage": "https://github.com/hoopyTL/tixgo-backend#readme"
}
