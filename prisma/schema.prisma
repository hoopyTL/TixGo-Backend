generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id            String    @id @default(uuid())
  title         String
  description   String?
  location      String?
  totalTickets  Int       @map("total_tickets")   
  remainTickets Int       @map("remain_tickets")  
  price         Float
  createdAt     DateTime  @default(now()) @map("created_at")
  bookings      Booking[] 

  @@map("events")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         String    @default("buyer")
  createdAt    DateTime  @default(now()) @map("created_at")
  bookings     Booking[] 
  idempotencies Idempotency[]

  @@map("users")
}

model Booking {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  eventId   String   @map("event_id")
  status    String   @default("CONFIRMED") // CONFIRMED | CANCELLED
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id])
  event     Event    @relation(fields: [eventId], references: [id])

  @@map("bookings")
}

model Idempotency {
  key            String    @id                     // Idempotency-Key nhận từ Header
  userId         String    @map("user_id")         // Cô lập theo User
  requestHash    String    @map("request_hash")    // Tránh payload mismatch
  status         String    @default("PROCESSING")  // PROCESSING | COMPLETED
  responseStatus Int?      @map("response_status") // HTTP code 
  responseBody   String?   @map("response_body")   // JSON response 
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User      @relation(fields: [userId], references: [id])

  @@unique([userId, key])                          
  @@map("idempotency_keys")
}