generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id            String    @id @default(uuid())
  title         String
  description   String?
  location      String?
  totalTickets  Int       @map("total_tickets")   
  remainTickets Int       @map("remain_tickets")  
  price         Decimal   @db.Decimal(12, 2)
  createdAt     DateTime  @default(now()) @map("created_at")
  organizerId   String?   @map("organizer_id")
  organizer     User?     @relation(fields: [organizerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bookings      Booking[] 
  seats         Seat[]
  reservations  Reservation[]

  @@index([organizerId])
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "events_created_at_id_idx")
  @@map("events")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         String    @default("buyer")
  createdAt    DateTime  @default(now()) @map("created_at")
  bookings     Booking[] 
  idempotencies Idempotency[]
  events       Event[]
  reservations Reservation[]

  @@map("users")
}

model Booking {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  eventId   String   @map("event_id")
  status    String   @default("CONFIRMED") // CONFIRMED | CANCELLED
  createdAt DateTime @default(now()) @map("created_at")
  seatId String? @map("seat_id")
  reservationId String? @unique @map("reservation_id")

  user      User     @relation(fields: [userId], references: [id])
  event     Event    @relation(fields: [eventId], references: [id])
  seat      Seat? @relation(fields: [seatId], references: [id], onDelete: Restrict)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@map("bookings")
}

model Idempotency {
  key            String                            // Idempotency-Key received from the header
  userId         String    @map("user_id")         // Cô lập theo User
  requestHash    String    @map("request_hash")    // Tránh payload mismatch
  operation      String    @default("booking.create.v1")
  status         String    @default("PROCESSING")  // PROCESSING | COMPLETED
  responseStatus Int?      @map("response_status") // HTTP code 
  responseBody   String?   @map("response_body")   // JSON response 
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User      @relation(fields: [userId], references: [id])

  @@id([userId, key])
  @@map("idempotency_keys")
}

model Seat {
  id String @id @default(uuid())
  eventId String @map("event_id")
  number Int
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  reservations Reservation[]
  bookings Booking[]

  @@unique([eventId, number])
  @@unique([id, eventId])
  @@map("seats")
}

model Reservation {
  id String @id
  userId String @map("user_id")
  eventId String @map("event_id")
  seatId String @map("seat_id")
  status String @default("HELD")
  expiresAt DateTime @db.Timestamptz(3) @map("expires_at")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  seat Seat @relation(fields: [seatId], references: [id], onDelete: Restrict)
  booking Booking?

  @@unique([id, userId, eventId, seatId])
  @@index([eventId, status])
  @@map("reservations")
}
