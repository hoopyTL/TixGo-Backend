generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id           String   @id @default(uuid())
  title        String
  description  String?
  location     String?
  totalTickets Int      @map("total_tickets")
  price        Float
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("events")
}