DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tixgo?schema=public
JWT_SECRET=replace-this-with-a-long-random-local-secret
JWT_EXPIRES_IN=1d
PORT=3000
REDIS_URL=redis://localhost:6379
RESERVATION_TTL_SECONDS=300
MAX_EVENT_SEATS=10000
RESERVATION_POLL_MS=1000
RESERVATION_BATCH_SIZE=100
BOOKING_LOCK_TIMEOUT_MS=1000
BOOKING_TRANSACTION_TIMEOUT_MS=5000
BOOKING_RETRY_ATTEMPTS=3
BOOKING_RETRY_DEADLINE_MS=10000
